/* Shared tweaks for every theme. Colours come from the palette. */

QListWidget#Sidebar {
    border: none;
    font-size: 11pt;
    padding-top: 6px;
    outline: none;
}
QListWidget#Sidebar::item {
    padding: 8px 12px;
    border-radius: 4px;
    margin: 1px 6px;
}
QListWidget#Sidebar::item:selected {
    background: palette(highlight);
    color: palette(highlighted-text);
}
QListWidget#Sidebar::item:hover:!selected {
    background: palette(alternate-base);
}

QLabel.hint, QLabel[hint="true"] {
    color: #c62828;
    font-size: 9pt;
}

QLabel[role="badge"] {
    border-radius: 8px;
    padding: 1px 8px;
    font-size: 9pt;
    font-weight: bold;
}

QLabel[role="prefill-note"] {
    font-style: italic;
    padding: 4px;
}

QLabel[role="page-title"] {
    font-size: 15pt;
    font-weight: 600;
}

QFrame[role="card"] {
    border: 1px solid palette(mid);
    border-radius: 6px;
    background: palette(base);
}
QFrame[role="card"][selected="true"] {
    border: 2px solid palette(highlight);
}

QPushButton[role="primary"] {
    font-weight: bold;
    padding: 6px 14px;
}

QPushButton[role="chip"] {
    border: 1px solid palette(mid);
    border-radius: 10px;
    padding: 2px 10px;
}
